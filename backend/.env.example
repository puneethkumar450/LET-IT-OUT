# Copy to backend/.env for local development; never commit the real file.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/LET-IT-OUT/backend/firebase-admin.json
FIREBASE_PROJECT_ID=let-it-out-d661a
PORT=8080
APP_ENV=local
CHAT_ENABLED=true
CHAT_USER_HOURLY_LIMIT=20
CHAT_GLOBAL_HOURLY_LIMIT=300
# Optional one-avatar live pilot. Create this face from the woman/adult portrait in Simli.
SIMLI_API_KEY=
SIMLI_FACE_ID_WOMAN_ADULT=
