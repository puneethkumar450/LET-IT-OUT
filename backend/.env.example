# Set these as environment variables in your shell or hosting provider.
# Never commit a real .env file.
GROQ_API_KEY=replace-me
GROQ_MODEL=openai/gpt-oss-120b
# gpt-oss reasons before it answers, and those tokens share this budget. Keep it well above the reply length.
GROQ_MAX_COMPLETION_TOKENS=2048
# low | medium | high (only sent to openai/gpt-oss models)
GROQ_REASONING_EFFORT=medium
# Cap on AI calls per minute across all users (protects the Groq key from scripted guest accounts).
GLOBAL_REQUESTS_PER_MINUTE=60
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
FIREBASE_PROJECT_ID=replace-me
PORT=8080
# Where flagged replies (reason + reply text + hashed reporter) are appended as JSON lines. Keep it out of Git.
REPORTS_FILE=reports.jsonl
# Size cap for that file in bytes (default 50 MB). Once full, new reports are refused until it is moved or emptied.
REPORTS_MAX_BYTES=52428800
