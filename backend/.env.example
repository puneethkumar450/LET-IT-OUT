# Copy to backend/.env for local development; never commit the real file.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Model that checks messages for self-harm risk (free tier is enough for a beta). Set to off to use the phrase check only.
GROQ_SAFETY_MODEL=openai/gpt-oss-20b
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/LET-IT-OUT/backend/firebase-admin.json
FIREBASE_PROJECT_ID=let-it-out-d661a
PORT=8080
APP_ENV=local
CHAT_ENABLED=true
CHAT_USER_HOURLY_LIMIT=20
CHAT_GLOBAL_HOURLY_LIMIT=300
# Optional one-avatar live pilot. Use the selected Simli face until a matching portrait is available.
SIMLI_API_KEY=
SIMLI_FACE_ID_PILOT=
# Optional 9:16 mood backgrounds uploaded to your Simli account. See docs/LIVE_AVATAR_PILOT.md.
SIMLI_BACKGROUND_ID_ANGRY=
SIMLI_BACKGROUND_ID_SAD=
SIMLI_BACKGROUND_ID_STRESSED=
SIMLI_BACKGROUND_ID_ANXIOUS=
SIMLI_BACKGROUND_ID_LONELY=
SIMLI_BACKGROUND_ID_HAPPY=
SIMLI_BACKGROUND_ID_TALK=
